# Editor configuration, see http://editorconfig.org
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
charset = utf-8
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = false

# Options with limited editor support
max_line_length = 120

[*.md]
max_line_length = off

[*.{yaml,yml}]
indent_style = space
indent_size = 2
